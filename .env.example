# z.ai API Configuration
ZAI_API_KEY=your_zai_api_key_here
ZAI_EMBEDDING_ENDPOINT=https://api.z.ai/api/embeddings
ZAI_LLM_ENDPOINT=https://api.z.ai/api/coding/paas/v4
ZAI_LLM_MODEL=glm-4.7

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION_NAME=pdf_tables

# Processing Configuration
MAX_FILE_SIZE_MB=100
API_TIMEOUT_SECONDS=10
CACHE_ENABLED=true
LOG_LEVEL=INFO
PARALLEL_WORKERS=4
APP_ENV=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# LDAP Authentication (development only)
# This local LDAP server is plaintext `ldap://` with no TLS; keep `LDAP_USE_TLS=false`.
# Start it with `uv run ldap` and stop it with `uv run ldap-stop`.
# Default runtime dir is port-scoped (`/tmp/pdf-intelligence-portal-ldap-3890`); override with `LDAP_RUN_DIR` if needed.
# Redis is not required for this local LDAP server or the current PDF portal auth flow.
# Never use the seeded credentials or these example secrets in production.
LDAP_SERVER_URL=ldap://localhost:3890
LDAP_USE_TLS=false
LDAP_BASE_DN=OU=YourCompany,DC=hc,DC=com
LDAP_SERVICE_BIND_DN=CN=admin,DC=hc,DC=com
LDAP_SERVICE_BIND_PASSWORD=secret
LDAP_USER_FILTER=(uid={username})
LDAP_ATTR_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_DEPARTMENT=departmentNumber
LDAP_ATTR_ROLE=title

# Auth Cookie / JWT
AUTH_SECRET_KEY=replace-with-a-strong-random-secret
AUTH_TOKEN_EXPIRE_HOURS=8
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
