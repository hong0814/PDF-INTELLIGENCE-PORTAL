# Embedding API Configuration
ZAI_API_KEY=
ZAI_EMBEDDING_ENDPOINT=https://api.z.ai/api/embeddings

# Ollama LLM Configuration
OLLAMA_API_KEY=your_ollama_api_key_here
ZAI_LLM_ENDPOINT=https://ollama.com/v1
ZAI_LLM_MODEL=gpt-oss:120b
ZAI_LLM_RERANK_MODEL=gpt-oss:120b

# ChromaDB Fallback Configuration
CHROMA_PERSIST_DIR=./.chroma
CHROMA_COLLECTION_NAME=pdf_tables

# Vector Backend Configuration
VECTOR_BACKEND=weaviate

# Weaviate Configuration
WEAVIATE_HOST=127.0.0.1
WEAVIATE_PORT=8113
WEAVIATE_GRPC_PORT=8114
WEAVIATE_USE_EMBEDDED=true
WEAVIATE_DATA_DIR=./db/weaviate
WEAVIATE_CLUSTER_HOSTNAME=Embedded_at_50851
WEAVIATE_TABLE_COLLECTION=PdfTable
WEAVIATE_CHUNK_COLLECTION=PdfChunk
WEAVIATE_HYBRID_ALPHA=0.6
WEAVIATE_SEARCH_MODE=vector

# Local Service Ports
PDF_PORTAL_HOST=127.0.0.1
PDF_PORTAL_PORT=8111
PDF_PORTAL_UI_PORT=8110
PDF_PORTAL_HYBRID_PORT=8112
VITE_API_BASE_URL=http://localhost:8111

# Login / LDAP Configuration
AUTH_ENABLED=true
AUTH_IDLE_TIMEOUT_SECONDS=600
AUTH_WARN_BEFORE_SECONDS=60
AUTH_SESSION_TTL_SECONDS=3600
AUTH_PRE_AUTH_TTL_SECONDS=300
AUTH_OTP_CODE=123456
AUTH_DEV_USERS=123456:1234:Developer User:user,admin:admin:Administrator:admin
LDAP_SERVER=
LDAP_BASE_DN=DC=hc,DC=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(uid={username})

# Processing Configuration
MAX_FILE_SIZE_MB=100
API_TIMEOUT_SECONDS=10
CACHE_ENABLED=true
LOG_LEVEL=INFO
PARALLEL_WORKERS=4
